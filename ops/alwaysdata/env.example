# ~/.aifi-host/env on the alwaysdata server. chmod 600. Never commit a filled copy.
# GitHub fine-grained token "aifi-server": resource owner SproutHouse, only AiFi_Executor, Contents read and write.
GH_TOKEN=
# Your ntfy / Slack / Discord webhook (the same value as the repo's ALERT_WEBHOOK secret).
ALERT_WEBHOOK=
# Live agents only, added when an agent goes live (paper needs none). Core uses no suffix.
# HL_AGENT_KEY_TREND_1D=
# HL_ACCOUNT_ADDRESS_TREND_1D=
